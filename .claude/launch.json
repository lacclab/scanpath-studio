{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scanpath-studio",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "streamlit",
        "run",
        "streamlit_app.py",
        "--server.port",
        "8511",
        "--server.headless",
        "true",
        "--server.address",
        "127.0.0.1"
      ],
      "port": 8511
    },
    {
      "name": "docs",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--extra",
        "docs",
        "mkdocs",
        "serve",
        "--dev-addr",
        "127.0.0.1:8766",
        "--no-livereload"
      ],
      "port": 8766
    },
    {
      "name": "gazegenie",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd ../../GazeGenie && exec .venv/bin/streamlit run app.py --server.headless true --server.port 8502"
      ],
      "port": 8502
    }
  ]
}
