{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "scanpath-app",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "streamlit_app.py",
        "--server.port",
        "8502",
        "--server.headless",
        "true"
      ],
      "port": 8502
    },
    {
      "name": "docs",
      "runtimeExecutable": "mkdocs",
      "runtimeArgs": ["serve", "--dev-addr", "127.0.0.1:8503"],
      "port": 8503
    }
  ]
}
