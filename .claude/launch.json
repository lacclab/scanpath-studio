{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tracker-archive",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tracker/server.py",
        "--port",
        "8790",
        "--no-open"
      ],
      "port": 8790
    },
    {
      "name": "scanpath-studio",
      "runtimeExecutable": "streamlit",
      "runtimeArgs": [
        "run",
        "streamlit_app.py",
        "--server.port",
        "8511",
        "--server.headless",
        "true"
      ],
      "port": 8511
    }
  ]
}
